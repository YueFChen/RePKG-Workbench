<Window x:Class="RePKG.App.Views.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:gif="http://wpfanimatedgif.codeplex.com"
        xmlns:loc="clr-namespace:RePKG.App.Localization"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="RePKG Workbench"
        Width="1320"
        Height="820"
        MinWidth="980"
        MinHeight="640"
        AllowDrop="True"
        PreviewDragEnter="OnPreviewDragEnter"
        PreviewDragLeave="OnPreviewDragLeave"
        PreviewDragOver="OnPreviewDragOver"
        PreviewDrop="OnPreviewDrop"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{DynamicResource WindowBrush}">
        <Image Panel.ZIndex="0"
               Source="{Binding BackgroundImagePath, Converter={StaticResource LocalImageConverter}, ConverterParameter=1920}"
               Stretch="UniformToFill"
               Opacity="{Binding BackgroundOpacity, Mode=OneWay}"
               Visibility="{Binding IsCustomBackground, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
        <Border Panel.ZIndex="1" Background="{DynamicResource WindowOverlayBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Padding="20"
                        Background="{DynamicResource PanelTranslucentBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="2,0,2,18">
                            <TextBlock Foreground="{DynamicResource HeadingTextBrush}" FontSize="25" FontWeight="SemiBold" Text="RePKG Workbench" />
                            <TextBlock Margin="0,5,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="{loc:Loc App.Subtitle, Default='Wallpaper Engine Project Manager'}" />
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    AutomationProperties.Name="{loc:Loc Nav.InputAutomation, Default='Switch to input projects'}"
                                    Command="{Binding SwitchViewCommand}"
                                    CommandParameter="input"
                                    Content="{loc:Loc Nav.Input, Default='Input projects'}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NavigationButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsInputView}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Grid.Column="1"
                                    AutomationProperties.Name="{loc:Loc Nav.OutputAutomation, Default='Switch to output projects'}"
                                    Command="{Binding SwitchViewCommand}"
                                    CommandParameter="output"
                                    Content="{loc:Loc Nav.Output, Default='Output projects'}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NavigationButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOutputView}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="2,0,8,0">
                                <TextBlock Margin="0,0,0,8" Foreground="{DynamicResource HeadingTextBrush}" FontSize="16" FontWeight="SemiBold" Text="{loc:Loc Section.Paths, Default='Paths'}" />

                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOutputView}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Margin="0,5" Foreground="{DynamicResource SecondaryTextBrush}" Text="{loc:Loc Field.InputDirectory, Default='Input directory'}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 AutomationProperties.Name="{loc:Loc Field.InputDirectory, Default='Input directory'}"
                                                 Text="{Binding InputPath, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Grid.Column="1" Margin="6,0,0,0" Command="{Binding BrowseInputCommand}" Content="{loc:Loc Action.Browse, Default='Browse'}" Style="{StaticResource ButtonStyle}" />
                                    </Grid>
                                </StackPanel>

                                <TextBlock Margin="0,11,0,5" Foreground="{DynamicResource SecondaryTextBrush}" Text="{loc:Loc Field.OutputDirectory, Default='Output directory'}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             AutomationProperties.Name="{loc:Loc Field.OutputDirectory, Default='Output directory'}"
                                             Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="1" Margin="6,0,0,0" Command="{Binding BrowseOutputCommand}" Content="{loc:Loc Action.Browse, Default='Browse'}" Style="{StaticResource ButtonStyle}" />
                                </Grid>

                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOutputView}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Margin="0,11,0,5" Foreground="{DynamicResource SecondaryTextBrush}" Text="RePKG.exe" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 AutomationProperties.Name="{loc:Loc Field.RePkgPath, Default='RePKG path'}"
                                                 Text="{Binding RePkgPath, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Grid.Column="1" Margin="6,0,0,0" Command="{Binding BrowseRePkgCommand}" Content="{loc:Loc Action.Browse, Default='Browse'}" Style="{StaticResource ButtonStyle}" />
                                    </Grid>

                                    <Separator Margin="0,18,0,15" />
                                    <TextBlock Margin="0,0,0,7" Foreground="{DynamicResource HeadingTextBrush}" FontSize="16" FontWeight="SemiBold" Text="{loc:Loc Section.Extraction, Default='Extraction options'}" />
                                    <CheckBox IsChecked="{Binding RecursiveScan}" Content="{loc:Loc Option.RecursiveScan, Default='Scan subdirectories'}" />
                                    <CheckBox IsChecked="{Binding ConvertTex}" Content="{loc:Loc Option.ConvertTex, Default='Convert TEX textures'}" />
                                    <CheckBox IsChecked="{Binding CopyProject}" Content="{loc:Loc Option.CopyProject, Default='Copy project.json'}" />
                                    <CheckBox IsChecked="{Binding CopyPreview}" Content="{loc:Loc Option.CopyPreview, Default='Copy alternate preview images'}" />
                                    <CheckBox IsChecked="{Binding Overwrite}" Content="{loc:Loc Option.Overwrite, Default='Overwrite existing output'}" />
                                </StackPanel>

                                <Button Margin="0,10,0,0"
                                        Command="{Binding DetectSteamCommand}"
                                        Content="{loc:Loc Action.DetectSteam, Default='Detect Steam paths'}"
                                        Style="{StaticResource ButtonStyle}" />

                                <Separator Margin="0,18,0,15" />
                                <TextBlock Margin="0,0,0,8" Foreground="{DynamicResource HeadingTextBrush}" FontSize="16" FontWeight="SemiBold" Text="{loc:Loc Section.Appearance, Default='Appearance'}" />
                                <TextBlock Margin="0,0,0,4" Foreground="{DynamicResource SecondaryTextBrush}" Text="{loc:Loc Field.Language, Default='Language'}" />
                                <ComboBox AutomationProperties.Name="{loc:Loc Field.Language, Default='Language'}"
                                          ItemsSource="{Binding LanguageChoices}"
                                          SelectedValue="{Binding Language, Mode=TwoWay}"
                                          SelectedValuePath="Value">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Margin="0,9,0,4" Foreground="{DynamicResource SecondaryTextBrush}" Text="{loc:Loc Field.Theme, Default='Theme'}" />
                                <ComboBox AutomationProperties.Name="{loc:Loc Field.Theme, Default='Theme'}"
                                          ItemsSource="{Binding ThemeChoices}"
                                          SelectedValue="{Binding ThemeMode, Mode=TwoWay}"
                                          SelectedValuePath="Value">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Grid Margin="0,9,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Command="{Binding BrowseBackgroundCommand}" Content="{loc:Loc Action.SelectBackground, Default='Select custom background'}" Style="{StaticResource ButtonStyle}" />
                                    <Button Grid.Column="1" Command="{Binding ClearBackgroundCommand}" Content="{loc:Loc Action.Clear, Default='Clear'}" Style="{StaticResource ButtonStyle}" />
                                </Grid>
                                <TextBlock Margin="0,8,0,4" Foreground="{DynamicResource SecondaryTextBrush}" Text="{loc:Loc Field.BackgroundOpacity, Default='Background visibility'}" />
                                <Slider Minimum="0.1"
                                        Maximum="1"
                                        TickFrequency="0.05"
                                        Value="{Binding BackgroundOpacity, Mode=TwoWay}" />
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="3" Margin="0,16,0,0">
                            <Button Command="{Binding SaveSettingsCommand}" Content="{loc:Loc Action.SaveSettings, Default='Save settings'}" Style="{StaticResource ButtonStyle}" />
                            <Button Command="{Binding ScanCommand}" Content="{loc:Loc Action.ScanRefresh, Default='Scan / Refresh'}" Style="{StaticResource PrimaryButtonStyle}" />
                            <Button Command="{Binding ExtractSelectedCommand}" Content="{loc:Loc Action.ExtractSelected, Default='Extract selected'}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOutputView}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Command="{Binding DeleteSelectedCommand}" Content="{loc:Loc Action.DeleteSelected, Default='Permanently delete selected'}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource DangerButtonStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOutputView}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Margin="22,18,22,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="2,0,2,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Foreground="{DynamicResource HeadingTextBrush}"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Text="{Binding ViewTitle}" />
                            <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding StatusMessage}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Margin="0,0,12,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="{Binding SelectionSummary}" />
                        <Button Grid.Column="2"
                                MinWidth="74"
                                Height="38"
                                Margin="0,0,7,0"
                                Command="{Binding SelectAllCommand}"
                                Content="{loc:Loc Action.SelectAllResults, Default='Select all results'}"
                                Style="{StaticResource ButtonStyle}" />
                        <Button Grid.Column="3"
                                MinWidth="92"
                                Height="38"
                                Margin="0"
                                Command="{Binding ClearSelectionCommand}"
                                Content="{loc:Loc Action.ClearSelection, Default='Clear selection'}"
                                Style="{StaticResource ButtonStyle}" />
                    </Grid>

                    <Border Grid.Row="1"
                            Height="50"
                            Margin="2,0,2,14"
                            Background="{DynamicResource PanelTranslucentBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Margin="14,0,12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="15"
                                           Text="&#xE721;" />
                                <Grid Grid.Column="1">
                                    <TextBox x:Name="ProjectSearchBox"
                                             Padding="0"
                                             AutomationProperties.Name="{loc:Loc Search.Automation, Default='Search projects'}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Margin="1,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               IsHitTestVisible="False"
                                               Text="{loc:Loc Search.Placeholder, Default='Search project names or paths'}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=ProjectSearchBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Grid>
                            <Border Grid.Column="1" Margin="0,9" Background="{DynamicResource BorderBrush}" />
                            <TextBlock Grid.Column="2"
                                       Margin="14,0,8,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="{loc:Loc Field.Type, Default='Type'}" />
                            <ComboBox Grid.Column="3"
                                      Height="38"
                                      Margin="0,5,5,5"
                                      AutomationProperties.Name="{loc:Loc Filter.ProjectType, Default='Project type filter'}"
                                      ItemsSource="{Binding ProjectTypes}"
                                      SelectedValue="{Binding SelectedType}"
                                      SelectedValuePath="Value">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="2"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ItemsView}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel IsItemsHost="True" Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="246"
                                            Height="276"
                                            Margin="6"
                                            Padding="0"
                                            CornerRadius="10"
                                            Tag="{Binding DataContext, ElementName=RootWindow}">
                                        <Border.ContextMenu>
                                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                                         Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Header="{loc:Loc Action.ExtractProject, Default='Extract project'}"
                                                          Command="{Binding Tag.ExtractOneCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}">
                                                    <MenuItem.Style>
                                                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Tag.IsOutputView, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </MenuItem.Style>
                                                </MenuItem>
                                                <MenuItem Header="{loc:Loc Action.OpenLocation, Default='Open in explorer'}"
                                                          Command="{Binding Tag.OpenLocationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                                <Separator Style="{StaticResource ContextMenuSeparatorStyle}" />
                                                <MenuItem Header="{loc:Loc Action.DeleteProject, Default='Delete project'}"
                                                          Command="{Binding Tag.DeleteOneCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}">
                                                    <MenuItem.Style>
                                                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Tag.IsOutputView, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </MenuItem.Style>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource CardBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                                        <Setter Property="BorderThickness" Value="2" />
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="142" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" Background="{DynamicResource InputBrush}" CornerRadius="9,9,0,0" ClipToBounds="True">
                                                <Grid>
                                                    <Image gif:ImageBehavior.AnimatedSource="{Binding PreviewPath, Converter={StaticResource LocalImageConverter}, ConverterParameter=480}"
                                                           gif:ImageBehavior.RepeatBehavior="Forever"
                                                           Stretch="UniformToFill" />
                                                    <MediaElement Source="{Binding VideoSource}"
                                                                  IsMuted="True"
                                                                  LoadedBehavior="Manual"
                                                                  MediaEnded="OnPreviewMediaEnded"
                                                                  MediaFailed="OnPreviewMediaFailed"
                                                                  MediaOpened="OnPreviewMediaOpened"
                                                                  ScrubbingEnabled="True"
                                                                  Stretch="UniformToFill"
                                                                  Unloaded="OnPreviewMediaUnloaded"
                                                                  UnloadedBehavior="Manual"
                                                                  Visibility="{Binding HasVideoPreview, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    <Border Margin="9"
                                                            Padding="8,4"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Top"
                                                            Background="{DynamicResource PanelTranslucentBrush}"
                                                            CornerRadius="5">
                                                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding TypeName}" />
                                                    </Border>
                                                    <CheckBox Margin="10"
                                                              HorizontalAlignment="Right"
                                                              VerticalAlignment="Top"
                                                              AutomationProperties.Name="{loc:Loc Selection.ProjectAutomation, Default='Select project'}"
                                                              IsChecked="{Binding IsSelected}" />
                                                </Grid>
                                            </Border>
                                            <Grid Grid.Row="1" Margin="13,11,13,12">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0"
                                                           Foreground="{DynamicResource HeadingTextBrush}"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           ToolTip="{Binding Title}"
                                                           Text="{Binding Title}" />
                                                <TextBlock Grid.Row="1"
                                                           Margin="0,6,0,5"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           FontSize="12"
                                                           Text="{Binding DirectoryPath}"
                                                           TextWrapping="Wrap" />
                                                <Grid Grid.Row="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               FontSize="12"
                                                               Text="{Binding SizeText}" />
                                                    <Button Grid.Column="1"
                                                            Padding="10,4"
                                                            Command="{Binding DataContext.OpenLocationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Content="{loc:Loc Action.Open, Default='Open'}"
                                                            Style="{StaticResource ButtonStyle}" />
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Grid.Row="3"
                            Margin="2,12,2,0"
                            Padding="14,11"
                            Background="{DynamicResource PanelTranslucentBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Visibility="{Binding IsBusy, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Margin="0,0,0,5" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding CurrentItem}" />
                                    <ProgressBar Height="7" Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}" />
                                </StackPanel>
                                <Button Grid.Column="1" Margin="12,0,0,0" Command="{Binding CancelCommand}" Content="{loc:Loc Action.CancelTask, Default='Cancel task'}" Style="{StaticResource DangerButtonStyle}" />
                            </Grid>
                            <Expander Grid.Row="1" Margin="0,8,0,0" Header="{loc:Loc Section.TaskLog, Default='Task log'}">
                                <ListBox Height="116"
                                         Margin="0,6,0,0"
                                         ItemsSource="{Binding Logs}"
                                         FontFamily="Cascadia Mono, Consolas"
                                         FontSize="12" />
                            </Expander>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
        <Border x:Name="DropOverlay"
                Panel.ZIndex="20"
                Margin="18"
                Padding="32"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource PrimaryBrush}"
                BorderThickness="2"
                CornerRadius="14"
                IsHitTestVisible="False"
                Opacity="0.96"
                Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock HorizontalAlignment="Center"
                           Foreground="{DynamicResource PrimaryBrush}"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="46"
                           Text="&#xE8B7;" />
                <TextBlock Margin="0,18,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource HeadingTextBrush}"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Text="{loc:Loc Drop.Title, Default='Drop project folders to extract'}" />
                <TextBlock Margin="0,8,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="{loc:Loc Drop.Description, Default='Project folders and parent folders are supported'}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
